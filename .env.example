# ──────────────────────────────────────────────────────────────────────────
# ModusBI MCP Server — пример конфигурации.
# Скопируйте в `.env` и подставьте свои значения. Файл `.env` в .gitignore —
# реальные секреты НЕ коммитятся. Не публикуйте пароли/токены.
# Какие MCP-серверы нужны скиллам и как их настроить — см. MCP_SERVERS.md
# и .mcp.example.json.
# ──────────────────────────────────────────────────────────────────────────

# --- Подключение к порталу ModusBI (обязательно) ---
MODUSBI_URL=https://your-portal.example.com
MODUSBI_USERNAME=your_api_user
MODUSBI_PASSWORD=your_api_password
MODUSBI_INSTANCE_NAME=my-portal

# --- Режим безопасности процесса: readonly | demo | readwrite ---
# Эффективный режим = строжайший из (флаг запуска, этот потолок).
# Для прод/публичного деплоя предпочтительно readonly (+ запуск с --readonly).
MODUSBI_SECURITY_CEILING=readonly

# --- Необязательное ---
# Каталог для экспорта файлов
MODUSBI_EXPORT_DIR=~/Downloads/modusbi_exports
# Формат логов: text | json
MODUSBI_LOG_FORMAT=text

# --- Browser E2E (нужно только скиллам/агентам, которые логинятся в портал-UI:
#     modusbi-e2e, portal-component-probe, verify-report и пр.) ---
# Учётка для входа в веб-интерфейс. В нашей среде это ОТДЕЛЬНЫЙ пользователь от
# API-юзера (чтобы сессии браузера и сервера не конфликтовали); вы можете
# использовать ту же учётку портала.
MODUSBI_E2E_LOGIN=your_browser_user
MODUSBI_E2E_PASSWORD=your_browser_password

# --- Опциональные интеграции (раскомментируйте при использовании) ---
# Plane (трекер задач) — для plane-скиллов:
# PLANE_API_KEY=your_plane_api_key
# PLANE_WORKSPACE_SLUG=your_workspace
# Внешняя БД для аналитических скиллов (postgres MCP):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
